# Opcional: Job Hunter crea este archivo solo en el primer arranque, y el
# token/chat de Telegram se pueden poner desde el dashboard (Avanzado ->
# Notificaciones). Aqui van solo secretos, nunca comportamiento de busqueda.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
